# ============================================================
#  Local secrets for Fantasy Hockey Roster Analyzer
#  This file is gitignored. Never commit it or paste it anywhere.
# ============================================================

# ------------------------------------------------------------
#  1. FILL THESE IN  (copy from developer.yahoo.com/apps -> your app)
# ------------------------------------------------------------
YAHOO_CLIENT_ID=PASTE_YOUR_YAHOO_CLIENT_ID_HERE
YAHOO_CLIENT_SECRET=PASTE_YOUR_YAHOO_CLIENT_SECRET_HERE

# ------------------------------------------------------------
#  2. CHOOSE A PASSWORD  (what you'll type to log into the app)
# ------------------------------------------------------------
APP_PASSWORD=CHOOSE_A_PASSWORD_HERE

# ------------------------------------------------------------
#  3. GENERATE A SESSION SECRET  (run: openssl rand -hex 32)
# ------------------------------------------------------------
SESSION_SECRET=PASTE_OUTPUT_OF_openssl_rand_-hex_32_HERE

# ------------------------------------------------------------
#  Already set for you - no need to touch these
# ------------------------------------------------------------
YAHOO_LEAGUE_ID=8076
YAHOO_REDIRECT_URI=https://localhost:8000
# Local dev reads a downloaded copy of the league salary sheet:
LEAGUE_SHEET_XLSX=private/league_sheet.xlsx

# ------------------------------------------------------------
#  Later (milestone M5, deployment) - leave blank for now
# ------------------------------------------------------------
FIRESTORE_PROJECT_ID=
# The service-account key's JSON *content* (not a file path): serverless
# functions have no persistent filesystem to hold a key file.
FIRESTORE_SERVICE_ACCOUNT_JSON=
# The league salary sheet's ID (from its URL). Share the sheet view-only with
# the service account's email.
LEAGUE_SHEET_ID=
