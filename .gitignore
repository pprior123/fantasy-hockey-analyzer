# Secrets and credentials - never commit these
.env
.env.*
secrets.json
*.pem
# GCP / Firebase service-account keys (M5)
*firebase-adminsdk*.json
*service-account*.json
*serviceaccount*.json
# GCP console keys download as <project>-<hash>.json: no JSON at the repo root
/*.json
!/vercel.json
!/firebase.json

# Yahoo OAuth tokens (yahoofantasy / yfpy write these)
.yahoofantasy
token.json
private.json
oauth2.json

# Local database and caches
*.db
*.sqlite
*.sqlite3
/data/
/cache/

# Salary imports (may contain league data)
*.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
coverage.json
coverage.xml
htmlcov/
mutants/
.mutmut-cache
dist/
build/
*.egg-info/

# Vercel CLI
.vercel/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Owner's private source data (never commit)
private/
*.xlsx
*.xls

# Template with placeholders only (safe to commit)
!.env.example

# Firestore emulator logs
*-debug.log
